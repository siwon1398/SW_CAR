def right_side_occupied(lidar_obj, scan, config): #오른쪽에 있는지 확인하는 함수
    """우측면 각도/거리 범위 안의 포인트 수로 차량 존재를 판단.
    반환: (있음 여부, 포인트 개수, 최근접 포인트 각도, 최근접 포인트 거리mm, 필터링된 포인트 배열)
    최근접 포인트가 없으면 각도/거리는 None."""
    pts = lidar_obj.getAngleDistanceRange(
        scan,
        config.RIGHT_SIDE_MIN_ANGLE, config.RIGHT_SIDE_MAX_ANGLE,
        config.RIGHT_SIDE_MIN_DIST, config.RIGHT_SIDE_MAX_DIST
    )
    if len(pts) > 0:
        closest_idx = np.argmin(pts[:, 1])
        closest_angle = float(pts[closest_idx, 0])
        closest_dist = float(pts[closest_idx, 1])
    else:
        closest_angle, closest_dist = None, None
    return len(pts) >= config.RIGHT_OCC_MIN_POINTS, len(pts), closest_angle, closest_dist, pts


def get_dist_at_angle(lidar_obj, scan, target_angle, tolerance, min_dist, max_dist, min_points=1):
    """target_angle ± tolerance 좁은 구역 안 최근접 포인트 거리(mm) 반환.
    포인트 수가 min_points 미만이면 노이즈로 보고 None 반환."""
    pts = lidar_obj.getAngleDistanceRange(
        scan, target_angle - tolerance, target_angle + tolerance, min_dist, max_dist
    )
    if len(pts) >= min_points:
        return float(np.min(pts[:, 1]))
    return None


def compute_align_fwd_duration(first_car_dist_mm, config):
    """첫차 감지 시점 270도 거리로 보정된 ALIGN_FWD 지속시간(초) 계산."""
    duration = config.ALIGN_FWD_DURATION
    if first_car_dist_mm is not None and first_car_dist_mm >= config.FIRST_CAR_DIST_FAR_THRESHOLD_MM:
        duration += config.ALIGN_FWD_DURATION_FAR_BONUS
    return duration


def compute_left_fwd_duration(first_car_dist_mm, config):
    """첫차 감지 시점 270도 거리로 보정된 LEFT_FWD 지속시간(초) 계산."""
    duration = config.LEFT_FWD_DURATION
    if first_car_dist_mm is not None and first_car_dist_mm >= config.FIRST_CAR_DIST_FAR_THRESHOLD_MM:
        duration += config.LEFT_FWD_DURATION_FAR_ADJUST
    return duration


# 중복 명령 전송 방지 및 유실 복구용 전역 변수
last_sent_cmd = ""
last_sent_time = 0.0
current_target_steer = 90  # 📊 [NEW] 아두이노에 마지막으로 송신된 실시간 진짜 조향각 변수

def send_cmd(ser, cmd, force=False): #cmd를 보내는함수
    global last_sent_cmd, last_sent_time, current_target_steer
    if ser is not None and ser.is_open:
        now = time.time()
        # 동일한 명령이면서 마지막 송신 후 300ms(0.30초)가 지나지 않았다면 송신을 스킵합니다. (force=True면 무조건 전송)
        if not force and cmd == last_sent_cmd and (now - last_sent_time) < 0.30:
            return
        ser.write(cmd.encode('utf-8'))
        ser.flush()  # OS 버퍼를 비우고 아두이노로 즉각 물리적 송신 보장
        last_sent_cmd = cmd
        last_sent_time = now
        
        # 📊 [NEW] 아두이노에 실제로 날아간 조향 지령(Axx, Bxx)을 가로채어 박제!
        try:
            if (cmd.startswith('A') or cmd.startswith('B')) and len(cmd) > 1:
                val = int(cmd[1:].strip())
                if val > 0: # "A0" 같은 특수 릴리즈 명령은 제외하고 실물 조향 타겟만 동기화
                    current_target_steer = val
        except Exception:
            pass


