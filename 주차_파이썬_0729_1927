            if scan is not None:
                try:
                    occupied, n_pts, closest_angle, closest_dist, right_pts = right_side_occupied(
                        lidar_stream.lidar, scan, Config)
                except Exception as e:
                    print(f"우측면 판정 예외: {e}")

            # [DEBUG] 레이더 시각화 창 갱신 (전체 스캔 + 우측 감시구역 + 최근접 각도/거리 라벨)
            cv2.imshow('Lidar Radar', draw_radar(scan, Config))
            # [PARK-US] 초음파 4개 실시간 디버그 창 갱신
            cv2.imshow('Ultrasonic Debug', draw_ultrasonic_debug(us_readings, Config))

            # 디바운스 카운터 갱신
            if occupied:
                occ_streak += 1
                empty_streak = 0
            else:
                empty_streak += 1
                occ_streak = 0

            # --- 미션 제한 시간 체크 (시작 이후에만) ---
            if state not in ('IDLE', 'DONE') and (now - mission_start) > Config.MISSION_TIMEOUT:
                print("[!] 미션 제한 시간(4분) 초과 → 정지")
                send_cmd(ser, "S\n")
                state = 'DONE'

            # --- 상태 머신 ---
            if not is_driving:
                # 🚗 [수동 조종 모드] 시작 전(IDLE)일 때 키보드로 차를 직관적으로 복귀시킵니다.
                # 윗줄(e,r,t) = 전진(좌/직진/우), 아랫줄(d,f,g) = 후진(좌/직진/우)
                manual_keys = (ord('e'), ord('r'), ord('t'), ord('d'), ord('f'), ord('g'))
                if state == 'IDLE' and key in manual_keys:
                    if key == ord('e'):
                        send_cmd(ser, f"A{Config.STEER_MIN}\n")     # 좌향 선회 전진
                    elif key == ord('r'):
                        send_cmd(ser, f"A{Config.STEER_CENTER}\n")  # 일자 전진
                    elif key == ord('t'):
                        send_cmd(ser, f"A{Config.STEER_MAX}\n")     # 우향 선회 전진
                    elif key == ord('d'):
                        send_cmd(ser, f"B{Config.STEER_MIN}\n")     # 좌향 선회 후진
                    elif key == ord('f'):
                        send_cmd(ser, f"B{Config.STEER_CENTER}\n")  # 일자 후진
                    elif key == ord('g'):
                        send_cmd(ser, f"B{Config.STEER_MAX}\n")     # 우향 선회 후진
                else:
                    # 아무 키도 누르고 있지 않을 때는 즉시 제자리에 정차
                    send_cmd(ser, "S\n")
            elif state == 'IDLE':
                send_cmd(ser, "S\n")

            elif state == 'SCAN_FIRST':
                # 직진 전진하며 첫 번째 주차 차량이 우측에 잡히길 기다림 (조향 모터 비활성화 쌩직진)
                send_cmd(ser, "A0\n")
                # [PARK] 270도(차량 바로 옆, 수직 방향) 거리를 매 루프 계속 측정해서 최솟값 유지.
                # 한 스캔 안에 점이 RIGHT_OCC_MIN_POINTS개 미만이면 노이즈로 보고 무시.
                if scan is not None:
                    d = get_dist_at_angle(lidar_stream.lidar, scan, 270, Config.FIRST_CAR_ANGLE_TOLERANCE,
                                           Config.RIGHT_SIDE_MIN_DIST, Config.RIGHT_SIDE_MAX_DIST,
                                           min_points=Config.RIGHT_OCC_MIN_POINTS)
                    if d is not None and (first_car_dist_mm is None or d < first_car_dist_mm):
                        first_car_dist_mm = d
                if occ_streak >= Config.DEBOUNCE_FRAMES:
                    seen_first_car = True
                    state = 'SCAN_GAP'
                    state_start = now
                    # [DEBUG] 첫 차 감지 거리/각도 박제
                    history_first_car = f"{closest_dist:.0f}mm ({closest_angle:.0f}°)" if closest_dist is not None else "Detected"
                    print(f"[1] 첫 차량 감지 (포인트 {n_pts}개) → 빈 칸 탐색 시작")

            elif state == 'SCAN_GAP':
                # 계속 전진하며 우측이 '비는' 순간(= 목표 주차 칸 시작)을 기다림 (조향 모터 비활성화 쌩직진)
                send_cmd(ser, "A0\n")
                # [PARK] 아직 첫차 옆을 지나는 중(occupied)일 때만 270도 거리 계속 갱신 (최솟값 유지)
                if occupied and scan is not None:
                    d = get_dist_at_angle(lidar_stream.lidar, scan, 270, Config.FIRST_CAR_ANGLE_TOLERANCE,
                                           Config.RIGHT_SIDE_MIN_DIST, Config.RIGHT_SIDE_MAX_DIST,
                                           min_points=Config.RIGHT_OCC_MIN_POINTS)
                    if d is not None and (first_car_dist_mm is None or d < first_car_dist_mm):
                        first_car_dist_mm = d
                if seen_first_car and empty_streak >= Config.DEBOUNCE_FRAMES:
                    state = 'ALIGN_FWD'
                    state_start = now
                    # [DEBUG] 빈칸 감지 박제
                    history_gap_seen = "Detected (Gap OK)"
                    print("[2] 빈 칸 감지! 정렬 전진 시작")

            elif state == 'ALIGN_FWD':
                # 차체가 칸을 살짝 지나치도록 추가 전진
                send_cmd(ser, f"A{Config.STEER_CENTER}\n")

                # [PARK] 출발 위치 보정: 첫차가 270도 기준 멀리서 감지됐으면(왼쪽 시작 추정) 정렬 전진 시간 연장
                align_fwd_duration = compute_align_fwd_duration(first_car_dist_mm, Config)

                if should_advance(state_start, now, align_fwd_duration, key, "ALIGN_FWD", Config):
                    state = 'LEFT_FWD'
                    state_start = now
                    print("[3] 정렬 완료 → 좌로 꺾어 전진 시작")

            elif state == 'LEFT_FWD':
                # 좌로 꺾은 채 전진 → 후진 진입 각도 만들기
                send_cmd(ser, f"A{Config.STEER_MIN}\n")

                # [PARK] 출발 위치 보정: 첫차가 270도 기준 멀리서 감지됐으면(왼쪽 시작 추정) 좌회전 전진 시간 조정
                left_fwd_duration = compute_left_fwd_duration(first_car_dist_mm, Config)

                if should_advance(state_start, now, left_fwd_duration, key, "LEFT_FWD", Config):
                    # 정차 명령과 함께 바퀴를 우측 최대로 미리 꺾음
                    send_cmd(ser, f"A{Config.STEER_MAX}\n")
                    send_cmd(ser, "S\n")
                    state = 'REV_RIGHT_PREP'
                    state_start = now
                    print("[3.5] 진입각 완료 → 우로 꺾고 후진 대기")

            elif state == 'REV_RIGHT_PREP':
                # 정지 상태를 유지하여 서보 모터가 완전히 후진 조향 바퀴를 꺾을 시간을 제공합니다.
                send_cmd(ser, "S\n")
                if should_advance(state_start, now, Config.REV_RIGHT_PREP_DURATION, key, "REV_RIGHT_PREP", Config):
                    state = 'REV_RIGHT'
                    state_start = now
                    print("[4] 후진 대기 완료 → 우로 꺾어 후진 진입")

            elif state == 'REV_RIGHT':
                # ⚠️ B 명령: 아두이노에 후진 처리가 추가되어 있어야 함
                # 후진과 동시에 조향이 우측 목표로 이동함
                send_cmd(ser, f"B{Config.STEER_MAX}\n")

                # [NEW-SAFETY] 뒤 모서리(CL, CR) 충돌 위험 감시 및 긴급 회피
                escape = try_corner_escape(ser, us_readings, Config, adjust_count)
                if escape is not None:
                    state, new_mode, adjust_count, msg = escape
                    if new_mode is not None:
                        adjust_mode = new_mode
                    state_start = now
                    print(msg)
                    history_adjusts.append(msg)
                    continue

                if should_advance(state_start, now, Config.REV_RIGHT_DURATION, key, "REV_RIGHT", Config):
                    state = 'REV_STRAIGHT'
                    state_start = now
                    print("[5] 핸들 중앙, 직진 후진")

            elif state == 'REV_STRAIGHT':
                send_cmd(ser, f"B{Config.STEER_CENTER}\n")

                # 📊 [NEW-SAFETY] 뒤 모서리(CL, CR) 충돌 회피 감시.
                # 최초 후진(adjust_count==0)만 REV_RIGHT 회전 직후 안정화 유예(SAFE_TIME) 적용,
                # 재시도 후진(adjust_count>0)은 정지 상태에서 재진입하는 거라 유예 없이 즉시 감시
                # (유예를 걸면 직전 회피가 부족한 채로 재진입했을 때 위험 구간에서도 그대로 더 후진해버림).
                corner_check_ready = (adjust_count == 0 and (now - state_start) >= Config.REV_STRAIGHT_SAFE_TIME) \
                    or (adjust_count > 0)
                if corner_check_ready:
                    escape = try_corner_escape(ser, us_readings, Config, adjust_count)
                    if escape is not None:
                        state, new_mode, adjust_count, msg = escape
                        if new_mode is not None:
                            adjust_mode = new_mode
                        state_start = now
                        print(msg)
                        history_adjusts.append(msg)
                        continue

                # [FIX] 수정 주차를 반복할수록 누적되어 뒤로 밀려나는 현상 방지
                # - 최초 후진(adjust_count=0) 시에는 주차 칸 안으로 깊게 진입하도록 REV_STRAIGHT_DURATION(1.5초) 적용
                # - 수정 재후진(adjust_count>0) 시에는 전진했던 시간만큼만 제자리 복귀하도록 PARK_ADJUST_FWD_DURATION(1.2초) 동적 적용
                curr_duration = Config.REV_STRAIGHT_DURATION if adjust_count == 0 else Config.PARK_ADJUST_FWD_DURATION

                # [NEW] 라이다 기반 후진 자동정지 판단
                # 수정전진(REV_STRAIGHT_ADJUST)이 차를 입구쪽으로 빼내므로, 재후진 때도 다시
                # 양옆 차량 위치까지 돌아왔는지를 라이다로 확인해 정지시킵니다 (시간 대칭 오차 보정).
                # curr_duration(위)이 안전 상한으로 남아있어 라이다 미검출 시에도 무한 후진하지 않습니다.
                stop_by_lidar = False
                if (now - state_start) >= Config.REV_STRAIGHT_SAFE_TIME:
                    if should_stop_by_lidar_both_sides(scan, Config):
                        print("[5.15] 라이다 좌우 양옆 차량 포착! 골인 정지 트리거 발생")
                        stop_by_lidar = True

                # 안전 타이머(curr_duration)가 다 찼거나, 라이다 자동정지 조건이 만족되면 정지 및 다음 판단으로 전환
                if stop_by_lidar or should_advance(state_start, now, curr_duration, key, "REV_STRAIGHT", Config):
                    # 일자 후진 완료 직전 평행 오차 및 우측 거리를 확인합니다.
                    rf = us_readings.get('RF')
                    rr = us_readings.get('RR')
                    
                    # 📊 [NEW-SAFETY] 후진 시간 타이머가 다 차지 않았는데(조기 멈춤 정황인데) 센서가 결측(None)이라면,
                    # 다 안 들어간 상태이므로 주차 정차 처리를 스킵하고 후진 주행을 그대로 계속 진행시킵니다!
                    if (rf is None or rr is None) and not should_advance(state_start, now, curr_duration, key, "REV_STRAIGHT", Config):
                        continue
                        
                    # 📊 [NEW-SAFETY] 타이머 만료 시점에도 하나라도 결측이면 평행 여부는 판단 불가.
                    # 성공(PARKED) 판정은 절대 내리지 않고, 남은 값이 있으면 그 값만으로 거리(SPREAD/CLOSE) 방향은 판단합니다.
                    data_incomplete = (rf is None or rr is None)

                    avg_dist = None
                    if adjust_count < Config.MAX_ADJUST_LIMIT:
                        if not data_incomplete:
                            is_crooked = abs(rf - rr) > Config.PARALLEL_DIFF_MARGIN_CM
                            avg_dist = (rf + rr) / 2.0
                        else:
                            is_crooked = False
                            avg_dist = rf if rf is not None else rr  # 둘 다 없으면 None

                        is_out_of_range = (avg_dist is not None) and \
                            (abs(avg_dist - Config.DESIRED_WALL_DIST_CM) > Config.DESIRED_WALL_DIST_MARGIN_CM)  # 35cm 기준 허용 오차 마진 초과 여부

                        if is_crooked or is_out_of_range or data_incomplete:
                            adjust_count += 1

                            # 📊 수정 원인 분류 연산
                            if data_incomplete:
                                reason = "센서결측"
                            elif is_crooked and is_out_of_range:
                                reason = "둘다불량"
                            elif is_crooked:
                                reason = "비평행"
                            else:
                                reason = "거리오차"

                            # 📊 [NEW] 평형 최우선 판정 구조 S자 래치
                            if is_crooked:
                                adjust_mode = 'PARALLEL_ONLY'
                                # [PARK] 정차(막 멈춘) 시점 RF/RR로 목표 조향각을 한 번만 계산해서 고정.
                                # 전진 중 센서가 옆차를 지나쳐 결측되어도 흔들리지 않도록 실시간 재계산 대신 절대값으로 사용.
                                if not data_incomplete:
                                    angle_error = rf - rr
                                    steer_offset = int(angle_error * Config.PARALLEL_KP)
                                    parallel_fixed_steer = max(min(Config.STEER_CENTER + steer_offset, Config.STEER_MAX), Config.STEER_MIN)
                                else:
                                    parallel_fixed_steer = Config.STEER_CENTER
                            elif is_out_of_range:
                                if avg_dist < Config.DESIRED_WALL_DIST_CM:
                                    adjust_mode = 'SPREAD'
                                else:
                                    adjust_mode = 'CLOSE'
                            else:
                                adjust_mode = 'PARALLEL_ONLY'  # 거리조차 판단 못 함(둘 다 결측) → 방향 없이 직진 왕복

                            # [NEW-SAFETY] 기어 역전 보호: 모터 정지 명령 후 물리 대기
                            send_cmd(ser, "S\n")
                            time.sleep(Config.GEAR_REVERSE_DELAY)
                            state = 'REV_STRAIGHT_ADJUST'
                            state_start = now
                            print(f"[5.2] 재정렬 기동 개시 ({reason} / 모드:{adjust_mode} / 수정 {adjust_count}회차)")

                            # 📊 [DEBUG] 누적 히스토리 기록 내에 한글 원인 텍스트 탑재!
                            rf_str = f"{rf:.1f}" if rf is not None else "-"
                            rr_str = f"{rr:.1f}" if rr is not None else "-"
                            adjust_info = f"#{adjust_count}: RF {rf_str}/RR {rr_str} ({reason})"
                            history_adjusts.append(adjust_info)
                            continue

                    # 합격 시 혹은 수정 한도 도달 시 주차 완료
                    state = 'PARKED'
                    state_start = now
                    send_cmd(ser, "S\n")
                    print("[6] 주차 완료. 4초 정차 (규칙 3~5초)")
                    # [DEBUG] 최종 판정 기록
                    if rf is not None and rr is not None:
                        history_decision = f"PARKED (SUCCESS) at RF {rf:.1f}/RR {rr:.1f}"
                    else:
                        history_decision = "PARKED (SUCCESS)"

            elif state == 'REV_STRAIGHT_ADJUST':
                # [NEW-SAFETY] 회피 기동 도중에도 뒤 모서리 위험 감시 (반대쪽이 새로 위험해질 수 있음).
                # 방금 시작한 회피가 자리잡을 시간을 주기 위해 SAFE_TIME 유예 후부터 체크.
                # 단, 이미 그 방향으로 회피 중인 같은 모서리면 재트리거하지 않고 계속 진행시킵니다
                # (안 그러면 위험이 채 안 풀린 순간마다 계속 자기 자신을 재시작해서 조금씩만 움직이다 한도 소진됨).
                if (now - state_start) >= Config.REV_STRAIGHT_SAFE_TIME:
                    danger, corner = check_corner_danger(us_readings, Config)
                    already_escaping_this_corner = (
                        (corner == 'CL' and adjust_mode == 'CL_ESCAPE') or
                        (corner == 'CR' and adjust_mode == 'CR_ESCAPE')
                    )
                    if danger and not already_escaping_this_corner:
                        escape = try_corner_escape(ser, us_readings, Config, adjust_count)
                        if escape is not None:
                            state, new_mode, adjust_count, msg = escape
                            if new_mode is not None:
                                adjust_mode = new_mode
                            state_start = now
                            print(msg)
                            history_adjusts.append(msg)
                            continue

                # 📊 A안: S자 전/후반부 시간 분할 조향 연산
                elapsed_adj = now - state_start
                half_time = Config.PARK_ADJUST_FWD_DURATION / 2.5

                if adjust_mode == 'SPREAD': # 🟢 벽과 너무 가까워 옆으로 벌리는 S자 기동
                    if elapsed_adj < half_time:
                        steer = Config.STEER_MIN  # 전반부 (0.7초 동안): 좌측 최대(70도)로 멀어짐
                    else:
                        steer = Config.STEER_MAX  # 후반부 (0.7초 동안): 우측 최대(110도)로 평행 펴기
                elif adjust_mode == 'CLOSE':  # 🔵 벽과 너무 멀어 옆으로 좁히는 S자 기동
                    if elapsed_adj < half_time:
                        steer = Config.STEER_MAX  # 전반부 (0.7초 동안): 우측 최대(110도)로 벽에 가까워짐
                    else:
                        steer = Config.STEER_MIN  # 후반부 (0.7초 동안): 좌측 최대(70도)로 평행 펴기
                elif adjust_mode == 'CL_ESCAPE':  # 🟠 좌측뒤모서리 위험 → 같은 방향(좌)으로 꺾은 채 전진해 그 궤적을 되감아 탈출
                    steer = Config.STEER_MIN
                elif adjust_mode == 'CR_ESCAPE':  # 🟠 우측뒤모서리 위험 → 같은 방향(우)으로 꺾은 채 전진해 그 궤적을 되감아 탈출
                    steer = Config.STEER_MAX
                else:                         # 🟡 정차 시점에 계산해둔 고정 조향각 그대로 사용 (전진 중 재계산 안 함)
                    steer = parallel_fixed_steer

                # 계산된 S자 조향 신호 아두이노에 송출
                send_cmd(ser, f"A{steer}\n")
                
                if should_advance(state_start, now, Config.PARK_ADJUST_FWD_DURATION, key, "REV_STRAIGHT_ADJUST", Config):
                    # 재후진 전 모터를 정지하고 조향은 똑바로 펴줍니다.
                    send_cmd(ser, f"A{Config.STEER_CENTER}\n")
                    send_cmd(ser, "S\n")
                    state = 'REV_STRAIGHT_PREP'
                    state_start = now
                    print("[5.4] 교정 전진 완료 → 재후진 전 정지 대기")

            elif state == 'REV_STRAIGHT_PREP':
                # [NEW-SAFETY] 정지 대기 중에도 뒤 모서리 위험 감시 (직전 회피가 부족했을 경우 재시도).
                # 같은 모서리가 방금 막 끝난 회피와 동일하면 재시도 없이 그냥 정지 대기를 이어갑니다
                # (직전 ADJUST가 방금 그 방향으로 이미 최대한 회피한 상태라 곧바로 또 트리거하면 의미 있는 추가 이동 없이 한도만 소진됨).
                danger, corner = check_corner_danger(us_readings, Config)
                already_escaping_this_corner = (
                    (corner == 'CL' and adjust_mode == 'CL_ESCAPE') or
                    (corner == 'CR' and adjust_mode == 'CR_ESCAPE')
                )
                if danger and not already_escaping_this_corner:
                    escape = try_corner_escape(ser, us_readings, Config, adjust_count)
                    if escape is not None:
                        state, new_mode, adjust_count, msg = escape
                        if new_mode is not None:
                            adjust_mode = new_mode
                        state_start = now
                        print(msg)
                        history_adjusts.append(msg)
                        continue

                # 정지 상태 유지. 조향 목표각은 ADJUST 종료 시 이미 한 번 보냈고(A→S),
                # 펌웨어가 S 이후에도 target_angle을 유지하므로 서보가 계속 중앙(90도)으로 정렬됨.
                send_cmd(ser, "S\n", force=True)
                if should_advance(state_start, now, Config.REV_STRAIGHT_PREP_DURATION, key, "REV_STRAIGHT_PREP", Config):
                    state = 'REV_STRAIGHT'
                    state_start = now
                    print("[5.6] 정지 대기 완료 → 재후진(정렬) 시작")

            elif state == 'PARKED':
                send_cmd(ser, "S\n")
                # PARKED는 규칙상 3~5초 고정 정차이므로 단계 모드에서도 시간 기반 유지
                if (now - state_start) >= Config.PARKED_WAIT:
                    state = 'EXIT_FWD_PREP'
                    state_start = now
                    print("[6.5] 정차 해제 → 출차 직진 전진 시작")

            elif state == 'EXIT_FWD_PREP':
                # 핸들을 똑바로 정렬하고 전진 살짝
                send_cmd(ser, f"A{Config.STEER_CENTER}\n")
                if should_advance(state_start, now, Config.EXIT_FWD_PREP_DURATION, key, "EXIT_FWD_PREP", Config):
                    state = 'EXIT_TURN'
                    state_start = now
                    print("[7] 출차 준비 완료 → 전진 + 우회전 탈출")

            elif state == 'EXIT_TURN':
                # 후진 주차했으므로 차 머리는 통로 쪽 → 전진하며 우로 꺾어 OUT 방향으로
                send_cmd(ser, f"A{Config.STEER_MAX}\n")
                if should_advance(state_start, now, Config.EXIT_TURN_DURATION, key, "EXIT_TURN", Config):
                    state = 'EXIT_STRAIGHT'
                    state_start = now
                    print("[8] OUT 방향 직진")

            elif state == 'EXIT_STRAIGHT':
                send_cmd(ser, f"A{Config.STEER_CENTER}\n")
                if should_advance(state_start, now, Config.EXIT_STRAIGHT_DURATION, key, "EXIT_STRAIGHT", Config):
                    state = 'DONE'
                    send_cmd(ser, "S\n")
                    print("[9] 미션 종료 (OUT 라인 통과 목표). 정지.")

            elif state == 'DONE':
                send_cmd(ser, "S\n")

            # --- 상태 표시 ---
            canvas[:] = 0
            elapsed = (now - mission_start) if state not in ('IDLE',) and mission_start > 0 else 0.0
            label, motion, color = STATE_INFO.get(state, (state, "-", (255, 255, 255)))
            canvas = put_text_kr(canvas, f"[{state}] {label}", (10, 12), 22, (255, 255, 255))
            canvas = put_text_kr(canvas, motion, (10, 45), 32, color)

            # [DEBUG] 실시간 가변저항 디버그 정보 그리기 (화면 하단에 추가)
            canvas = put_text_kr(canvas, f"L Pot: {calib_l} | R Pot: {calib_r} | Cur Pot: {cur_pot}", 
                                  (10, 230), 16, (180, 255, 180))

            # --- 우측 히스토리 대시보드 경계선 및 누적 텍스트 렌더링 ---
            cv2.line(canvas, (570, 0), (570, 280), (100, 100, 100), 1) # 세로 분리선
            
            canvas = put_text_kr(canvas, "📊 이번 트라이 기록", (585, 12), 20, (255, 200, 0))
            canvas = put_text_kr(canvas, f"1. 첫 차 발견 : {history_first_car}", (585, 45), 14, (250, 250, 250))
            canvas = put_text_kr(canvas, f"2. 빈 칸 진입 : {history_gap_seen}", (585, 72), 14, (250, 250, 250))
            canvas = put_text_kr(canvas, f"3. 수정 돌입 시 초음파 (최근 3회):", (585, 100), 14, (0, 220, 255))
            
            # 최근 최대 3개의 수정 히스토리를 세로로 한 줄씩 출력
            for idx, adj in enumerate(history_adjusts[-3:]):
                canvas = put_text_kr(canvas, f"   {adj}", (585, 125 + idx * 23), 13, (200, 200, 200))
                
            # 최종 결과 표시 (성공=녹색, 대기/진행=흰색)
            dec_color = (0, 255, 0) if "PARKED" in history_decision else (180, 180, 180)
            canvas = put_text_kr(canvas, f"4. 최종 판정  : {history_decision}", (585, 215), 15, dec_color)

            # [PARK] 정렬 전진(ALIGN_FWD) 보정 예상 시간 표시 (270도 거리 기반)
            align_fwd_est = compute_align_fwd_duration(first_car_dist_mm, Config)
            dist_str = f"{first_car_dist_mm:.0f}mm" if first_car_dist_mm is not None else "-"
            if first_car_dist_mm is None:
                start_side = "판정 전"
            elif first_car_dist_mm >= Config.FIRST_CAR_DIST_FAR_THRESHOLD_MM:
                start_side = "왼쪽 시작 추정"
            else:
                start_side = "오른쪽 시작 추정"
            canvas = put_text_kr(canvas, f"5. 정렬전진: {align_fwd_est:.2f}s (기본 {Config.ALIGN_FWD_DURATION:.2f}s)",
                                  (585, 234), 12, (0, 220, 255))
            canvas = put_text_kr(canvas, f"   270도거리: {dist_str} -> {start_side}",
                                  (585, 248), 12, (0, 220, 255))

            # [PARK] 좌회전(LEFT_FWD) 보정 예상 시간 표시 (270도 거리 기반)
            left_fwd_est = compute_left_fwd_duration(first_car_dist_mm, Config)
            canvas = put_text_kr(canvas, f"6. 좌회전  : {left_fwd_est:.2f}s (기본 {Config.LEFT_FWD_DURATION:.2f}s)",
                                  (585, 264), 12, (0, 220, 255))

            # [NEW] 실시간 목표 조향각 및 아두이노 실제 피드백 조향각 오버레이 (송출된 target 조향각 그대로 표출)
            target_ang = current_target_steer
            ang_actual = current_angle_actual if current_angle_actual is not None else "-"
            canvas = put_text_kr(canvas, f"Target Steer: {target_ang}° | Actual: {ang_actual}°",
                                  (10, 85), 16, (0, 200, 255))

            # [DEBUG] 실시간 센서 감지 상태 한글 메시지 생성
            sensor_status = "센서 상태: 대기"
            sensor_color = (200, 200, 200)
            if state == 'SCAN_FIRST':
                if occupied:
                    sensor_status = f"차량 발견! (디바운스: {occ_streak}/3)"
                    sensor_color = (0, 220, 255)
                else:
                    sensor_status = "우측 첫 차량 탐색 중..."
                    sensor_color = (150, 150, 150)
            elif state == 'SCAN_GAP':
                if not occupied:
                    sensor_status = f"빈 주차칸 포착! (디바운스: {empty_streak}/3)"
                    sensor_color = (0, 255, 0)
                else:
                    sensor_status = "첫 차량 통과 중 (옆구리 감시)"
                    sensor_color = (0, 165, 255)
            elif state == 'ALIGN_FWD':
                sensor_status = "빈 칸 확보 성공! 정렬 기동 중"
                sensor_color = (0, 255, 0)
            elif state == 'LEFT_FWD':
                sensor_status = "진입각 생성 중 (좌회전 전진)"
                sensor_color = (0, 255, 255)

            canvas = put_text_kr(canvas, f"Right pts: {n_pts}  occ:{occ_streak} emp:{empty_streak}",
                                  (10, 110), 18, (0, 255, 255))

            # 📡 [DEBUG] 실시간 한글 센서 피드백 출력 (Y=136)
            canvas = put_text_kr(canvas, f"📡 {sensor_status}", (10, 136), 18, sensor_color)

            # [DEBUG] 가까운 순 상위 3개 포인트 표시 (Y좌표 163으로 조정)
            if right_pts is not None and len(right_pts) > 0:
                order = np.argsort(right_pts[:, 1])[:3]
                top_line = "  ".join(
                    f"{right_pts[i, 0]:.0f}°/{right_pts[i, 1]:.0f}mm" for i in order
                )
                lidar_line = f"근접 top3: {top_line}"
                lidar_color = (0, 255, 255)
            else:
                lidar_line = "근접 top3: 감지 없음"
                lidar_color = (120, 120, 120)
            canvas = put_text_kr(canvas, lidar_line, (10, 163), 17, lidar_color)
            canvas = put_text_kr(canvas, f"Mission time: {elapsed:.1f}s / {Config.MISSION_TIMEOUT:.0f}s",
                                  (10, 193), 19, (255, 255, 255))
            step_hint = "  [n] next step" if Config.DEBUG_STEP_MODE else ""
            s_hint = "[s] start" if state == 'IDLE' else "[s] stop/reset"
            canvas = put_text_kr(canvas, f"{s_hint}  [q] quit{step_hint}",
                                  (10, 220), 17, (200, 200, 200))
            cv2.imshow('Parking Status', canvas)

            # [DEBUG] key는 루프 상단에서 이미 읽음 (waitKey 중복 호출 제거)
            if key == ord('q'):
                print("프로그램 종료.")
                break
            elif key == ord('s'):
                if state == 'IDLE':
                    # 최초 시작
                    is_driving = True
                    state = 'SCAN_FIRST'
                    mission_start = now
                    state_start = now
                    occ_streak = 0
                    empty_streak = 0
                    seen_first_car = False
                    first_car_dist_mm = None
                    adjust_count = 0  # 수정 기동 횟수 카운터 리셋
                    parallel_fixed_steer = Config.STEER_CENTER
                    
                    # [DEBUG] 트라이 히스토리 변수 리셋
                    history_first_car = "-"
                    history_gap_seen = "-"
                    history_adjusts.clear()
                    history_decision = "-"
                    print("==== 🚗 주차 미션 시작! ====")
                elif state != 'DONE':
                    # 🌟 [CHANGED] 일시정지/재개 대신, s를 누르면 초기 정지 상태(IDLE)로 완전히 복귀
                    # (e/r/t/d/f/g 수동 조종이 다시 가능해짐. 진행 상황은 리셋되고, 다시 s를 누르면 처음부터 새 미션 시작)
                    is_driving = False
                    state = 'IDLE'
                    send_cmd(ser, "S\n")
                    print("==== ⏹ 초기 정지 상태로 복귀 (e/r/t/d/f/g 수동 조종 가능) ====")

    except KeyboardInterrupt:
        print("\n사용자 강제 종료.")
    except Exception as e:
        print(f"\n에러 발생: {e}")
    finally:
        print("안전 종료 절차...")
        if ser is not None and ser.is_open:
            try:
                ser.write(b'S\n')
                time.sleep(0.1)
                ser.close()
                print("아두이노q 포트 닫힘.")
            except Exception as e:
                print(f"아두이노 종료 에러: {e}")
        if lidar_stream is not None:
            lidar_stream.release()
        cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
