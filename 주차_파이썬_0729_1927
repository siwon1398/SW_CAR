def check_corner_danger(us_readings, config):
    """CL/CR 중 하나라도 위험 거리 이하면 (True, 더 가까운 쪽 'CL'/'CR') 반환."""
    cl = us_readings.get('CL')
    cr = us_readings.get('CR')
    val_cl = cl if cl is not None else 999
    val_cr = cr if cr is not None else 999
    if val_cl <= config.CORNER_DANGER_CM or val_cr <= config.CORNER_DANGER_CM:
        return True, ('CL' if val_cl <= val_cr else 'CR')
    return False, None


def try_corner_escape(ser, us_readings, config, adjust_count):
    """위험 감지 시 회피 기동으로 전환할지 판단.
    반환: None(위험 없음) 또는 (new_state, new_adjust_mode 또는 None, new_adjust_count, log_msg).
    회피 방향은 위험한 쪽 모서리와 같은 방향으로 꺾어 그 순간 그린 궤적을 되감듯 빠져나갑니다
    (예: 우측뒤모서리(CR) 위험 → 우측으로 꺾은 채 전진해서 방금 커브를 되짚어 거리 확보)."""
    danger, corner = check_corner_danger(us_readings, config)
    if not danger:
        return None
    cl = us_readings.get('CL')
    cr = us_readings.get('CR')
    if adjust_count < config.MAX_ADJUST_LIMIT:
        adjust_count += 1
        adjust_mode = 'CL_ESCAPE' if corner == 'CL' else 'CR_ESCAPE'
        # [NEW-SAFETY] 기어 역전 보호: 모터 정지 명령 후 물리 대기
        send_cmd(ser, "S\n")
        time.sleep(config.GEAR_REVERSE_DELAY)
        msg = f"[SAFETY] 긴급! 뒤 모서리({corner}) 충돌 위험 (CL:{cl}cm, CR:{cr}cm, 수정 {adjust_count}회차) → {adjust_mode} 회피 시작"
        return 'REV_STRAIGHT_ADJUST', adjust_mode, adjust_count, msg
    else:
        send_cmd(ser, "S\n")
        msg = f"[SAFETY] 위험! 뒤 모서리 충돌 한계 도달 (수정 {adjust_count}회 한도 소진) → 즉각 비상 정차"
        return 'PARKED', None, adjust_count, msg


